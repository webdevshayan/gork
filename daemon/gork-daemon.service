[Unit]
Description=gork companion daemon (scheduled AI tasks, 24/7)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The installer generates this unit with resolved paths; this file is the
# reference shape of it. Configuration lives in the EnvironmentFile, not here.
WorkingDirectory=/opt/gork/daemon
Environment=GORK_HOME=/var/lib/gork-daemon
# --- Configure me: /etc/gork-daemon/config.env ---
# GORK_API_KEY, GORK_BASE_URL, GORK_MODEL, NTFY_TOPIC, GORK_SECRET, GORK_PORT
EnvironmentFile=-/etc/gork-daemon/config.env
ExecStart=/usr/bin/dart run bin/gork_daemon.dart
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
